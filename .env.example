# =============================================================================
# ClipForge AI — Environment Configuration Matrix
# =============================================================================
# Copy this file to .env and configure for your environment.

# =============================================================================
# 1. REQUIRED (Core System Configuration)
# =============================================================================
APP_NAME=ClipForge AI
APP_ENV=development                   # Options: development | production
DEBUG=true                            # Set false in production
SECRET_KEY=change-me-to-a-long-random-secret-32-chars-minimum
DATABASE_URL=sqlite+aiosqlite:///./clipforge.db
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=2000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# 2. DEVELOPMENT ONLY (Mock Mode & Local Testing)
# =============================================================================
DEMO_MODE=true                        # Enables guest access and demo workflows
MOCK_MODE=true                        # Use local AI simulation instead of external API billing
USE_REDIS=false                       # Use in-process asyncio task queue for dev

# =============================================================================
# 3. FEATURE FLAGS (Turn on/off specific pipeline stages)
# =============================================================================
ENABLE_TRANSCRIPTION=true             # Extract speech transcript & word timestamps
ENABLE_SMART_CROP=true                # Dynamic 9:16 vertical subject framing
ENABLE_DYNAMIC_CAPTIONS=true          # Word-level animated ASS subtitle burn-in
ENABLE_AI_CRITIC=true                 # Quality control critic inspection
ENABLE_AUTO_REVISION=true             # Automatic 3-cycle repair loop
ENABLE_BROLL=false                    # (Experimental) Cutaway B-roll overlays
ENABLE_MOTION_GRAPHICS=false          # (Experimental) Animated callout badges

# =============================================================================
# 4. PRODUCTION ONLY (External AI Providers & Managed Infrastructure)
# =============================================================================
# Database (PostgreSQL recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/clipforge

# Redis (Recommended for distributed worker clusters)
# REDIS_URL=redis://localhost:6379/0
# USE_REDIS=true

# Storage (S3 / Cloudflare R2 / MinIO)
# STORAGE_BACKEND=s3
# S3_BUCKET=clipforge-storage
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=

# AI Model Providers (When MOCK_MODE=false)
# LLM_PROVIDER=openai                 # mock | openai | anthropic
# SPEECH_PROVIDER=openai_whisper      # mock | openai_whisper | deepgram | assemblyai
# VISION_PROVIDER=mock                # mock | openai_vision | google_vision
# EMBEDDING_PROVIDER=mock             # mock | openai_embeddings

# API Keys
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o
# OPENAI_WHISPER_MODEL=whisper-1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
